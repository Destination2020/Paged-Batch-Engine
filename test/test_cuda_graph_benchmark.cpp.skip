  );
  
  // 初始化
  std::cout << "Initializing model...\n";
  auto status = model.init(base::DeviceType::kDeviceCUDA);
  if (!status) {
    std::cerr << "Failed to initialize model, error code: " << status.get_err_code() << "\n";
    return 1;
  }
  std::cout << "Model initialized.\n\n";
  
  // 准备测试数据
