  std::vector<int32_t> input_shape = {batch_size, 1};
  
  tensor::Tensor input(base::DataType::kDataTypeFp32, input_shape, true);
  input.to_cuda(nullptr);
  
  tensor::Tensor pos(base::DataType::kDataTypeInt32, {batch_size}, true);
  pos.to_cuda(nullptr);
  
  // 初始化 dummy 数据
  cudaMemset(input.ptr<void>(), 0, input.size() * sizeof(float));
  cudaMemset(pos.ptr<void>(), 0, pos.size() * sizeof(int32_t));
  cudaDeviceSynchronize();
  
  int test_iterations = 1000;
  
  std::cout << "Running benchmark with " << test_iterations << " iterations...\n\n";
  
  // 测试 1: 不使用 CUDA Graph
  model.EnableCUDAGraph(false);
  auto result_no_graph = benchmark_forward(
      model, input, pos, test_iterations, false, "Without CUDA Graph");
  
  // 测试 2: 捕获并使用 CUDA Graph
  std::cout << "Capturing CUDA Graph...\n";
  model.EnableCUDAGraph(true);
  status = model.CaptureDecodeGraph(batch_size, input_shape);
  
  if (!status) {
    std::cerr << "Warning: Failed to capture CUDA Graph, error code: " << status.get_err_code() << "\n";
    std::cerr << "Continuing with normal execution...\n\n";
  } else {
    std::cout << "CUDA Graph captured successfully.\n\n";
    
    auto result_with_graph = benchmark_forward(
        model, input, pos, test_iterations, true, "With CUDA Graph");
    
    // 计算加速比
    double speedup = result_no_graph.avg_time_us / result_with_graph.avg_time_us;
    double throughput_improvement = result_with_graph.throughput / result_no_graph.throughput;
    
    std::cout << "========================================\n";
    std::cout << "Performance Summary\n";
    std::cout << "========================================\n";
    std::cout << std::fixed << std::setprecision(2);
    std::cout << "Speedup:              " << speedup << "x\n";
    std::cout << "Throughput improvement: " << throughput_improvement << "x\n";
    std::cout << "Time reduction:        " 
              << (1.0 - 1.0/speedup) * 100.0 << "%\n";
    std::cout << "========================================\n";
    
    // 评估结果
    if (speedup > 1.1) {
      std::cout << "\n✅ CUDA Graph provides significant speedup!\n";
    } else if (speedup > 0.95) {
      std::cout << "\n⚠️  CUDA Graph provides minimal speedup.\n";
      std::cout << "    This may indicate that kernel launch overhead is not the bottleneck.\n";
    } else {
      std::cout << "\n❌ CUDA Graph is slower. This is unexpected.\n";
      std::cout << "    Please check the implementation.\n";
    }
  }
  
  return 0;
}
