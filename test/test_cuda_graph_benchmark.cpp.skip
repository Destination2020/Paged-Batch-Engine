  const char* token_path = std::getenv("KUIPER_TOKEN_PATH");
  
  if (!model_path || !token_path) {
    std::cerr << "Error: Please set KUIPER_MODEL_PATH and KUIPER_TOKEN_PATH\n";
    std::cerr << "Example:\n";
    std::cerr << "  export KUIPER_MODEL_PATH=/path/to/model.bin\n";
    std::cerr << "  export KUIPER_TOKEN_PATH=/path/to/tokenizer.model\n";
    return 1;
  }
  
  std::cout << "========================================\n";
  std::cout << "CUDA Graph Performance Benchmark\n";
  std::cout << "========================================\n";
  std::cout << "Model: " << model_path << "\n";
  std::cout << "Tokenizer: " << token_path << "\n\n";
  
  // 创建模型
