/**
 * CUDA Graph 性能基准测试
 * 
 * 使用方法:
 *   export KUIPER_MODEL_PATH=/path/to/model.bin
 *   export KUIPER_TOKEN_PATH=/path/to/tokenizer.model
 *   ./test_cuda_graph_benchmark
 */

#include <glog/logging.h>
#include <chrono>
#include <vector>
#include <iomanip>
#include "model/llama3.h"
#include "tensor/tensor.h"
#include <cuda_runtime.h>

using namespace std::chrono;

struct BenchmarkResult {
  double total_time_us;
  double avg_time_us;
  double throughput;
  int iterations;
};

BenchmarkResult benchmark_forward(model::LLama2Model& model, 
                                  const tensor::Tensor& input,
                                  const tensor::Tensor& pos,
                                  int iterations,
                                  bool use_graph,
                                  const std::string& name) {
  int next = 0;
  
  // 预热
  int warmup = 10;
  for (int i = 0; i < warmup; ++i) {
    model.predict(input, pos, false, next);
  }
  cudaDeviceSynchronize();
  
  // 实际测试
  auto start = high_resolution_clock::now();
  for (int i = 0; i < iterations; ++i) {
    model.predict(input, pos, false, next);
  }
  cudaDeviceSynchronize();
  auto end = high_resolution_clock::now();
  
  auto total_us = duration_cast<microseconds>(end - start).count();
  double avg_us = (double)total_us / iterations;
  double throughput = 1000000.0 / avg_us;  // tokens per second
  
  BenchmarkResult result;
  result.total_time_us = total_us;
  result.avg_time_us = avg_us;
  result.throughput = throughput;
  result.iterations = iterations;
  
  std::cout << std::fixed << std::setprecision(2);
  std::cout << name << ":\n";
  std::cout << "  Total time:    " << total_us / 1000.0 << " ms\n";
  std::cout << "  Avg time:      " << avg_us << " us/iter\n";
  std::cout << "  Throughput:    " << throughput << " tokens/s\n";
  std::cout << "\n";
  
  return result;
}

int main(int argc, char** argv) {
  google::InitGoogleLogging("CUDAGraphBenchmark");
  FLAGS_logtostderr = true;
  FLAGS_minloglevel = 1;  // 减少日志输出
  
